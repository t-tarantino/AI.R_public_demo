# Copy this file to `.env` and adjust values. `.env` is git-ignored.

# ---------------------------------------------------------------------------
# Database connection (SQLAlchemy URL)
# ---------------------------------------------------------------------------
# Temporary local bootstrap (default): file-based SQLite in the project root.
DATABASE_URL=sqlite:///./air.db

# Production / intended target: PostgreSQL (e.g. Supabase). No code changes
# required — just set DATABASE_URL. Use the Supabase "Session pooler" URI and
# convert the driver prefix to `postgresql+psycopg://`:
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local Postgres example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/air_internal

# Echo SQL statements to the console (useful while developing).
SQL_ECHO=false

# Application metadata. Set APP_ENV=production when deployed.
APP_NAME=AI.R public demo
APP_ENV=development

# Secret used to sign web session cookies. CHANGE THIS in production.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me

# Send session cookies only over HTTPS. Keep false for local http dev;
# set true in production (the Docker image already defaults it to true).
COOKIE_SECURE=false
